{
  "name": "complianceos",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @complianceos/db run generate",
    "db:migrate": "pnpm --filter @complianceos/db run migrate",
    "db:push": "pnpm --filter @complianceos/db run push",
    "db:studio": "pnpm --filter @complianceos/db run studio",
    "db:seed": "pnpm --filter @complianceos/db run seed"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
