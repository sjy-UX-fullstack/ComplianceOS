# ComplianceOS — Environment Variables
# Copy to .env.local for local development

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://complianceos:local_dev_password_2026@localhost:5432/complianceos_dev

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3 / MinIO ─────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=complianceos
S3_SECRET_KEY=local_dev_s3_2026
S3_BUCKET_AUDIT=complianceos-audit-evidence
S3_BUCKET_BREACH=complianceos-breach-evidence
S3_BUCKET_DOCUMENTS=complianceos-documents
S3_REGION=ap-south-1

# ─── Auth (Clerk) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Auth (WorkOS — Enterprise SSO) ─────────────────────────────────────────
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...

# ─── AI Gateway ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
AI_PRIMARY_MODEL=claude-haiku  # Use haiku for dev; sonnet for prod
AI_FALLBACK_MODEL=gpt-4.1-mini

# ─── Audit Trail ────────────────────────────────────────────────────────────
AUDIT_HMAC_SECRET=change-this-to-a-256-bit-random-secret-in-production

# ─── Razorpay ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
# Optional: account-level UPI Autopay mandate amount used for first ₹1 auth
RAZORPAY_UPI_AUTH_AMOUNT_PAISE=100

# ─── Billing / Invoicing ───────────────────────────────────────────────────
BILLING_LEGAL_ENTITY_NAME=ComplianceOS Technologies Pvt Ltd
BILLING_LEGAL_ENTITY_GSTIN=29ABCDE1234F1Z5
BILLING_LEGAL_ENTITY_PAN=ABCDE1234F
BILLING_LEGAL_ENTITY_ADDRESS=Bengaluru, Karnataka, India
BILLING_LEGAL_ENTITY_STATE_CODE=29

# ─── India APIs ─────────────────────────────────────────────────────────────
BHASHINI_API_KEY=...
BHASHINI_USER_ID=...
DIGILOCKER_CLIENT_ID=...
DIGILOCKER_CLIENT_SECRET=...
# Setu (DigiLocker wrapper) — falls back to a stub flow when blank
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
WHATSAPP_BUSINESS_TOKEN=...

# ─── App Config ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ComplianceOS
NODE_ENV=development
